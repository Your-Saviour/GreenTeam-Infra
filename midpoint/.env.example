# Copy to .env. Never commit the populated file.
MIDPOINT_PG_USER=midpoint
MIDPOINT_PG_DB=midpoint
# openssl rand -base64 36 | tr -d '\n'
MIDPOINT_PG_PASSWORD=

# Break-glass local administrator: openssl rand -base64 36 | tr -d '\n'
MIDPOINT_ADMIN_PASSWORD=

# Authentik OAuth2/OIDC provider credentials (provider/application slug: midpoint)
MIDPOINT_OIDC_CLIENT_ID=
# openssl rand -base64 48 | tr -d '\n'
MIDPOINT_OIDC_CLIENT_SECRET=

# High-trust token from the Authentik SCIM source midpoint-jit.
# Generate its source token in Authentik; do not reuse an API or user token.
MIDPOINT_SCIM_TOKEN=

MIDPOINT_PUBLIC_URL=https://access.gt.blueteam.au/midpoint
MIDPOINT_AUTHENTIK_ISSUER=https://auth.blueteam.au/application/o/midpoint/
MIDPOINT_AUTHENTIK_SCIM_URL=https://auth.blueteam.au/source/scim/midpoint-jit/v2
MIDPOINT_TIMEZONE=Australia/Adelaide
MIDPOINT_MEM_INIT=1024m
MIDPOINT_MEM_MAX=2048m
