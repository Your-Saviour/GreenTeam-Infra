# Copy to .env and chmod 600 .env, or enter these in Dockhand's stack environment.
TERMIX_DOMAIN=termix.blueteam.au
TERMIX_VERSION=26.11.0

# Generate EACH value independently: openssl rand -hex 32
# Back these up securely. Changing the database/encryption keys loses access
# to the existing database/stored credentials. Do not reuse the testing SALT.
TERMIX_JWT_SECRET=
TERMIX_DATABASE_KEY=
TERMIX_ENCRYPTION_KEY=
TERMIX_INTERNAL_AUTH_TOKEN=

# Confidential Authentik OAuth2/OIDC provider, application slug "termix".
TERMIX_OIDC_CLIENT_ID=
TERMIX_OIDC_CLIENT_SECRET=
TERMIX_OIDC_SLUG=termix
TERMIX_OIDC_ADMIN_GROUP=GROUP-GreenTeam
# Optional comma-separated email allowlist; blank permits anyone admitted
# by the Authentik application's group bindings (configure these first).
TERMIX_OIDC_ALLOWED_USERS=
