# Copy to .env and fill in all three secrets before deployment.
# Generate each secret separately with: openssl rand -hex 32
SESSION_SECRET=
DB_PASSWORD=
# Keep this key backed up: changing it makes stored mail credentials unreadable.
ENCRYPTION_KEY=

# Authentik confidential OAuth2 provider for the application slug "mailflow".
MAILFLOW_OIDC_CLIENT_ID=
MAILFLOW_OIDC_CLIENT_SECRET=
# Email of an existing GROUP-GreenTeam member; seeds a passwordless admin on
# an empty database. Must match that user's Authentik email exactly.
MAILFLOW_BOOTSTRAP_ADMIN_EMAIL=

# Hostname only, without https:// or a trailing slash.
MAILFLOW_DOMAIN=mail.blueteam.au
# Alternate hostname redirects to MAILFLOW_DOMAIN, keeping paths and queries.
MAILFLOW_ALIAS_DOMAIN=mailflow.blueteam.au
# Keep frontend and backend on the same release.
MAILFLOW_VERSION=4.1.1
